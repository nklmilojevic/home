        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(12, sum by (entity) (increase(hass_state_change_total[$__range])))",
          "legendFormat": "{{entity}}",
          "refId": "A",
          "instant": true
