          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(unpoller_unas_pool_usage_bytes{source=~\"$source\"}) / sum(unpoller_unas_pool_capacity_bytes{source=~\"$source\"})",
          "legendFormat": "used",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
