{
  "uid": "ups",
  "title": "UPS",
  "tags": ["nut", "ups", "power"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(network_ups_tools_ups_status{flag=\"OL\"}) + 2 * sum(network_ups_tools_ups_status{flag=\"OB\"}) + 4 * sum(network_ups_tools_ups_status{flag=\"LB\"}) + 8 * sum(network_ups_tools_ups_status{flag=\"FSD\"})",
          "legendFormat": "status",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Online",
                  "color": "green",
                  "index": 0
                },
                "2": {
                  "text": "On Battery",
                  "color": "orange",
                  "index": 1
                },
                "3": {
                  "text": "On Battery",
                  "color": "orange",
                  "index": 2
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 4,
                "to": 100,
                "result": {
                  "text": "LOW BATTERY",
                  "color": "red",
                  "index": 3
                }
              }
            },
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unknown",
                  "color": "red",
                  "index": 4
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
