---
version: v1alpha1
persist: true
machine:
  ca:
    crt: ref+op://homecluster/talos/MACHINE_CA_CRT
    {% if ENV.CONTROLPLANE %}
    key: ref+op://homecluster/talos/MACHINE_CA_KEY
    {% endif %}
  certSANs:
    - 10.40.0.3
    - 127.0.0.1
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: false # Cilium socketLB is disabled in this cluster
      resolveMemberNames: true
    kubePrism:
      enabled: true
      port: 7445
    {% if ENV.CONTROLPLANE %}
    kubernetesTalosAPIAccess:
      enabled: true
      allowedKubernetesNamespaces:
        - system-upgrade
      allowedRoles:
        - os:admin
    {% endif %}
    rbac: true
    stableHostname: true
  files:
    - op: create
      path: /etc/cri/conf.d/20-customization.part
      content: |-
        [plugins."io.containerd.cri.v1.images"]
          discard_unpacked_layers = false
    - op: overwrite
      path: /etc/nfsmount.conf
      permissions: 0o644
      content: |
        [ NFSMount_Global_Options ]
        nfsvers=3
        hard=True
        nolock=True
        async=True
        noatime=True
        nodiratime=True
        nconnect=16
        rsize=1048576
        wsize=1048576
  install:
    image: factory.talos.dev/installer/{{ ENV.SCHEMATIC }}:{{ ENV.TALOS_VERSION }}
    wipe: false
  kernel:
    modules:
      - name: dm_thin_pool # miroir lvmthin backend
      - name: drbd # miroir replication (from the siderolabs/drbd extension)
        parameters:
          - usermode_helper=disabled
      - name: drbd_transport_tcp
  kubelet:
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraConfig:
      allowedUnsafeSysctls:
        - net.ipv6.conf.*
      imageGCHighThresholdPercent: 70
      imageGCLowThresholdPercent: 55
      # Give workloads (ceph OSDs, movers) time to stop cleanly on reboot
      shutdownGracePeriod: 90s
      shutdownGracePeriodCriticalPods: 60s
    extraMounts:
      - destination: /var/openebs/local
        type: bind
        source: /var/openebs/local
        options:
          - bind
          - rshared
          - rw
    image: ghcr.io/siderolabs/kubelet:{{ ENV.KUBERNETES_VERSION }}
    nodeIP:
      validSubnets:
        - 10.40.0.0/24
  network:
    disableSearchDomain: true
  nodeLabels:
    node.kubernetes.io/exclude-from-external-load-balancers: ""
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.default_qdisc: fq
    net.core.netdev_max_backlog: "30000"
    net.core.rmem_max: "67108864"
    net.core.wmem_max: "67108864"
    net.ipv4.ping_group_range: "0 2147483647"
    net.ipv4.tcp_congestion_control: bbr
    net.ipv4.tcp_rmem: 4096 87380 33554432
    net.ipv4.tcp_tw_reuse: "1"
    net.ipv4.tcp_window_scaling: "1"
    net.ipv4.tcp_wmem: 4096 65536 33554432
    sunrpc.tcp_max_slot_table_entries: "128"
    sunrpc.tcp_slot_table_entries: "128"
    vm.nr_hugepages: "1024"
  time:
    disabled: false
    servers:
      - 162.159.200.1
      - 162.159.200.123
  token: ref+op://homecluster/talos/MACHINE_TOKEN
  udev:
    rules:
      - SUBSYSTEM=="drm", KERNEL=="renderD*", GROUP="44", MODE="0660"
      - SUBSYSTEMS=="usb", ATTRS{idVendor}=="1a6e", ATTRS{idProduct}=="089a", GROUP="20", MODE="0660"
      - SUBSYSTEMS=="usb", ATTRS{idVendor}=="18d1", ATTRS{idProduct}=="9302", GROUP="20", MODE="0660"
cluster:
  ca:
    crt: ref+op://homecluster/talos/CLUSTER_CA_CRT
    {% if ENV.CONTROLPLANE %}
    key: ref+op://homecluster/talos/CLUSTER_CA_KEY
    {% endif %}
  clusterName: home-kubernetes
  controlPlane:
    endpoint: https://10.40.0.3:6443
  discovery:
    enabled: true
    registries:
      kubernetes:
        disabled: true
      service:
        disabled: false
  id: ref+op://homecluster/talos/CLUSTER_ID
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.69.0.0/16
    serviceSubnets:
      - 10.96.0.0/16
  secret: ref+op://homecluster/talos/CLUSTER_SECRET
  token: ref+op://homecluster/talos/CLUSTER_TOKEN
  {% if ENV.CONTROLPLANE %}
  aggregatorCA:
    crt: ref+op://homecluster/talos/CLUSTER_AGGREGATORCA_CRT
    key: ref+op://homecluster/talos/CLUSTER_AGGREGATORCA_KEY
  allowSchedulingOnControlPlanes: true
  apiServer:
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
    certSANs:
      - 10.40.0.3
      - 127.0.0.1
    disablePodSecurityPolicy: true
    extraArgs:
      enable-aggregator-routing: "true"
    image: registry.k8s.io/kube-apiserver:{{ ENV.KUBERNETES_VERSION }}
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-controller-manager:{{ ENV.KUBERNETES_VERSION }}
  coreDNS:
    disabled: true
  etcd:
    advertisedSubnets:
      - 10.40.0.0/24
    ca:
      crt: ref+op://homecluster/talos/CLUSTER_ETCD_CA_CRT
      key: ref+op://homecluster/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:{{ ENV.KUBERNETES_VERSION }}
  scheduler:
    config:
      apiVersion: kubescheduler.config.k8s.io/v1
      kind: KubeSchedulerConfiguration
      profiles:
        - schedulerName: default-scheduler
          plugins:
            score:
              disabled:
                - name: ImageLocality
          pluginConfig:
            - name: PodTopologySpread
              args:
                defaultingType: List
                defaultConstraints:
                  - maxSkew: 1
                    topologyKey: kubernetes.io/hostname
                    whenUnsatisfiable: ScheduleAnyway
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-scheduler:{{ ENV.KUBERNETES_VERSION }}
  secretboxEncryptionSecret: ref+op://homecluster/talos/CLUSTER_SECRETBOXENCRYPTIONSECRET
  serviceAccount:
    key: ref+op://homecluster/talos/CLUSTER_SERVICEACCOUNT_KEY
  {% endif %}

# --- miroir raw volume ---
# Provisions partlabel `r-miroir` on the dedicated 1TB data NVMe, consumed by
# the MiroirNodeGroup as /dev/disk/by-partlabel/r-miroir.
#
# Live since the 2026-08-29 cutover: the disks were wiped of bluestore first,
# then apply-config provisioned this without a reboot.
#
# The selector is deliberately model-independent. The old
# `disk.model == "RS1D0TSSD710"` match silently stopped matching icarus003 when
# its dead NVMe was replaced with a KINGSTON OM8PGP41024Q-A0 -- the same
# model-locked-filter bug that broke the rook devicePathFilter on 2026-08-29.
# Verified against all three nodes: matches exactly the data NVMe on each and
# excludes every system disk (icarus001 SNV3S1000G, icarus002 SNV2S1000G,
# icarus003's SATA VK0300GDUQV). `system_disk` is the same boolean Talos uses
# for its own EPHEMERAL volume.
#
---
apiVersion: v1alpha1
kind: RawVolumeConfig
name: miroir
provisioning:
  diskSelector:
    match: disk.transport == "nvme" && !system_disk
  minSize: 1TB
